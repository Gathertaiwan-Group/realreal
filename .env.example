# ── Vercel (apps/web) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://realreal.cc
RAILWAY_API_URL=http://localhost:4000
INTERNAL_API_SECRET=

# Sentry — error reporting is enabled iff a DSN is set (NOT gated on NODE_ENV).
# NEXT_PUBLIC_SENTRY_DSN is inlined at build time and drives the browser SDK.
# SENTRY_DSN is read at runtime and drives the server + edge SDKs; if unset,
# they fall back to NEXT_PUBLIC_SENTRY_DSN. Leave both empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time only — source map upload in next.config.ts. Safe to leave empty.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Payment webhook validation
PCHOMEPAY_HASH_KEY=
PCHOMEPAY_HASH_IV=
LINEPAY_CHANNEL_SECRET=
JKOPAY_PUBLIC_KEY=

# ── Railway (apps/api) ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INTERNAL_API_SECRET=
PAYMENT_TOKEN_ENCRYPTION_KEY=

PCHOMEPAY_MERCHANT_ID=
PCHOMEPAY_HASH_KEY=
PCHOMEPAY_HASH_IV=

LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=

JKOPAY_STORE_ID=
JKOPAY_API_KEY=

ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

AMEGO_TAX_ID=60515111
AMEGO_APP_KEY=

# Transactional email (Resend). Can also be set in /admin/settings, which wins.
# Removed 2026-08-10: EMAIL_SMTP_HOST / _USER / _PASS — nothing read them; mail
# has gone through Resend for a long time.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# Sentry error reporting (apps/api). Same DSN-presence gate as the web app.
SENTRY_DSN=
# Where 線上錯誤告警信 goes. Empty → falls back to the /admin/settings
# 「管理員收件 Email」. Removed 2026-08-10: LINE_NOTIFY_TOKEN — LINE Notify was
# shut down 2025-03-31 and its endpoint is dead; alerts are email now.
ALERT_EMAIL=

TZ=Asia/Taipei

# Seed script only
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
